#!/bin/sh /etc/rc.common
START=99
STOP=10
USE_PROCD=1

start_service() {
    procd_open_instance qmi-status-collector
    procd_set_param command /usr/bin/qmi_status_collector.sh
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

stop_service() {
    killall qmi_status_collector.sh 2>/dev/null
}