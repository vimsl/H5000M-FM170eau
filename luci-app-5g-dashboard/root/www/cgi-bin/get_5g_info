#!/bin/sh
echo "Content-Type: application/json"
echo ""

SYS_COOKIE=$(echo "$HTTP_COOKIE" | tr ';' '\n' | grep '^sysauth_http=' | head -1 | cut -d= -f2-)
[ -n "$SYS_COOKIE" ] && AUTHED=1 || AUTHED=0

QMI=/tmp/modem_status.json

# v64.5 重构 (9/11): 删除死缓存链——CACHE/USE_CACHE 三行 + `false && J=$CACHE` 硬禁用
# （R0-② 确认级减法：last_good_5g.json 无写者、USE_CACHE 从未被消费, 纯死代码 5 行）
J=$QMI

getf() { jsonfilter -i "$J" -e "@.$1" 2>/dev/null; }

RSRP=$(getf rsrp)
RSRQ=$(getf rsrq)
SINR=$(getf sinr)
ARFCN=$(getf arfcn)
PCI=$(getf pci)
BAND=$(getf band)
DLBW=$(getf bandwidth)
MODE=$(getf networkMode)
OP=$(getf operator)
OPZ=$(getf operatorZh)
CELL=$(getf cellId)
TAC=$(getf tac)
QCI=$(getf qci)
IMEI=$(getf imei)
TEMP=$(getf temperature)
VOLT=$(getf voltage)
SIM=$(getf simStatus)
ICCID=$(getf iccid)
IMSI=$(getf imsi)
PHONE=$(getf phone)
CA_M=$(getf caMode)
CA_B=$(getf caBand)
CA_A=$(getf caArfcn)
CA_P=$(getf caPci)
CA_W=$(getf caBw)
IPV4=$(getf ipv4)
IPV6=$(getf ipv6)
NET=$(getf networkStatus)
DL_S=$(getf downloadSpeed)
UL_S=$(getf uploadSpeed)
# v63.3 (2026-09-08): 0.5s 独立速率通道覆盖 — speed_loop 每 0.5s 写 /tmp/speed_now.json,
# 新鲜(<5s)则优先于 modem_status.json 里的 30s 窗口均值
SPD=/tmp/speed_now.json
if [ -f "$SPD" ] && [ $(( $(date +%s) - $(stat -c %Y "$SPD" 2>/dev/null || echo 0) )) -lt 5 ]; then
    _dl=$(jsonfilter -i "$SPD" -e '@.dl' 2>/dev/null)
    _ul=$(jsonfilter -i "$SPD" -e '@.ul' 2>/dev/null)
    [ -n "$_dl" ] && DL_S="$_dl"
    [ -n "$_ul" ] && UL_S="$_ul"
fi
RXLEV=$(getf rxlev)
# 4 路天线从 modem_status.json 读真值(修复 shm 来源同值 bug)
ANTM=$(jsonfilter -i /tmp/modem_status.json -e '@.antMain' 2>/dev/null)
ANTD=$(jsonfilter -i /tmp/modem_status.json -e '@.antDiv' 2>/dev/null)
ANT1=$(jsonfilter -i /tmp/modem_status.json -e '@.antMimo1' 2>/dev/null)
ANT2=$(jsonfilter -i /tmp/modem_status.json -e '@.antMimo2' 2>/dev/null)
RXB=$(getf rxBytes)
TXB=$(getf txBytes)
UPT=$(getf uptime)
FW=$(getf firmware)
# v70 M4（2026-09-19 大审计）：lanPorts 原为硬编码（eth0/eth1 恒 "down"，无视真实状态）。
#   改为实测 /sys/class/net：carrier=1 → up；speed 取 sysfs。
# ⚠ v70.1 热修（2026-09-19）：这些值**必须在 printf 之前算好**。原实现把 $(...) 写进了下方
#   单引号 printf 的格式串 —— shell 对单引号不做命令替换 ⇒ JSON 里出现字面量
#   `$(_port_json eth0)` ⇒ 前端 r.json() 抛异常落 catch ⇒ 面板整页 "--"。
#   规矩：单引号格式串内一律不得出现 $( )，动态值全部走 %s 参数。
_port_json() {
    _p="$1"
    if [ "$(cat /sys/class/net/$_p/carrier 2>/dev/null)" = "1" ]; then _st="up"; else _st="down"; fi
    _sp=$(cat /sys/class/net/$_p/speed 2>/dev/null)
    case "$_sp" in
        ''|-1|*[!0-9]*) _spd="--" ;;   # down 时 sysfs 返回 -1；旧的 [ ] || [ ] && 写法会输出 "--M"
        *)              _spd="${_sp}M" ;;
    esac
    printf '{"name":"%s","state":"%s","speed":"%s"}' "$_p" "$_st" "$_spd"
}
P_ETH0=$(_port_json eth0)
P_ETH1=$(_port_json eth1)
P_BRLAN=$(_port_json br-lan)
ANT_SRC=$(jsonfilter -i /tmp/modem_status.json -e '@.antSource' 2>/dev/null)
[ -z "$ANT_SRC" ] && ANT_SRC=gtccinfo

[ $AUTHED -eq 0 ] && SIM=*** && ICCID=898****26 && IMSI=-- && PHONE=--

# aiqosd 算法参数
KFP=$(cat /tmp/aiqos_profile_kf_q 2>/dev/null)
KFR=$(cat /tmp/aiqos_profile_kf_r 2>/dev/null)
PKP=$(cat /tmp/aiqos_profile_pid_kp 2>/dev/null)
PKI=$(cat /tmp/aiqos_profile_pid_ki 2>/dev/null)
PKD=$(cat /tmp/aiqos_profile_pid_kd 2>/dev/null)
MBW=$(cat /tmp/aiqos_profile_min_bw 2>/dev/null)
ACKF=$(cat /tmp/aiqos_profile_ack_filter 2>/dev/null)
HOP=$(cat /tmp/aiqos_profile_handover 2>/dev/null)
[ -z "$HOP" ] && HOP=0

# 34.5j 哨兵: HNAT hook / aiqosd 存活 / 引擎场景 (异常 30 秒面板可见)
HOOK=$(cat /sys/kernel/debug/hnat/hook_toggle 2>/dev/null)
[ -z "$HOOK" ] && HOOK=unknown
if pgrep -f "/usr/bin/[a]iqosd" >/dev/null 2>&1; then AQLIVE=1; else AQLIVE=0; fi
SCEN=$(cat /tmp/aiqos_scenario 2>/dev/null)

printf '{
"networkStatus": "%s",
"networkMode": "%s",
"operator": "%s",
"operatorZh": "%s",
"band": "%s",
"bandwidth": "%s",
"downloadBandwidth": "%s",
"uploadBandwidth": "%s",
"rsrp": "%s",
"rsrq": "%s",
"sinr": "%s",
"arfcn": "%s",
"pci": "%s",
"cellId": "%s",
"tac": "%s",
"qci": "%s",
"imei": "%s",
"temperature": "%s",
"voltage": "%s",
"simStatus": "%s",
"iccid": "%s",
"imsi": "%s",
"phone": "%s",
"caMode": "%s",
"caBand": "%s",
"caArfcn": "%s",
"caPci": "%s",
"caBw": "%s",
"downloadSpeed": "%s",
"uploadSpeed": "%s",
"ipv4": "%s",
"ipv6": "%s",
"rxlev": "%s",
"antSource": "%s",
"antMain": "%s",
"antDiv": "%s",
"antMimo1": "%s",
"antMimo2": "%s",
"rxBytes": "%s",
"txBytes": "%s",
"uptime": "%s",
"firmware": "%s",
"profile": {
"kf_q": "%s",
"kf_r": "%s",
"pid_kp": "%s",
"pid_ki": "%s",
"pid_kd": "%s",
"min_bw": "%s",
"ack_filter": "%s",
"handover": "%s"
},
"sentinel": {
"hnat_hook": "%s",
"aiqosd_alive": "%s",
"aiqos_scenario": "%s"
},
"lanPorts": [%s,%s,%s]
}\n' \
"$NET" "$MODE" "$OP" "$OPZ" "$BAND" "$DLBW" "$DLBW" "$DLBW" \
"$RSRP" "$RSRQ" "$SINR" "$ARFCN" "$PCI" "$CELL" "$TAC" "$QCI" "$IMEI" "$TEMP" "$VOLT" \
"$SIM" "$ICCID" "$IMSI" "$PHONE" \
"$CA_M" "$CA_B" "$CA_A" "$CA_P" "$CA_W" \
"$DL_S" "$UL_S" \
"$IPV4" "$IPV6" "$RXLEV" \
"$ANT_SRC" "$ANTM" "$ANTD" "$ANT1" "$ANT2" \
"$RXB" "$TXB" "$UPT" "$FW" \
"$KFP" "$KFR" "$PKP" "$PKI" "$PKD" "$MBW" "$ACKF" "$HOP" \
"$HOOK" "$AQLIVE" "$SCEN" \
"$P_ETH0" "$P_ETH1" "$P_BRLAN"

