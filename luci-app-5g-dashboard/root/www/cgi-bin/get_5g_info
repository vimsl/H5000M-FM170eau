#!/bin/sh
echo "Content-Type: application/json"
echo "Access-Control-Allow-Origin: *"
echo ""

IFACE="wwan0"
QMI_STATUS="/tmp/modem_status.json"

# jsonfilter helper by key
get_key() {
    local json="$1" key="$2"
    echo "$json" | jsonfilter -e "@.modem_info[@.key=\"$key\"].value" 2>/dev/null
}

plmn_to_operator() {
    case "$1" in
        46000|46002|46007|46008) echo "CMCC" ;;
        46001|46006|46009)       echo "CUCC" ;;
        46003|46005|46011)       echo "CTCC" ;;
        46015|46004|46048)       echo "CBN" ;;
        46049|46099)             echo "CTCC" ;;
        *)                       echo "" ;;
    esac
}

# Real-time speed from sysfs (200ms window)
measure_speed() {
    RX1=$(cat /sys/class/net/$IFACE/statistics/rx_bytes 2>/dev/null || echo 0)
    TX1=$(cat /sys/class/net/$IFACE/statistics/tx_bytes 2>/dev/null || echo 0)
    if command -v usleep >/dev/null 2>&1; then
        usleep 200000
    else
        sleep 1
    fi
    RX2=$(cat /sys/class/net/$IFACE/statistics/rx_bytes 2>/dev/null || echo 0)
    TX2=$(cat /sys/class/net/$IFACE/statistics/tx_bytes 2>/dev/null || echo 0)
    DL_SPEED=$(awk "BEGIN {printf \"%.2f\", ($RX2 - $RX1) * 8 / 1000000}")
    UL_SPEED=$(awk "BEGIN {printf \"%.2f\", ($TX2 - $TX1) * 8 / 1000000}")
}

# Primary: official QModem ubus API
if ubus list 2>/dev/null | grep -q qmodem; then
    CONFIG_SECTION=""
    for section in $(uci show qmodem 2>/dev/null | sed -n "s/qmodem\.\([^.]*\)\..*/\1/p" | sort -u); do
        if uci get qmodem.$section.at_port >/dev/null 2>&1; then
            STATE=$(uci get qmodem.$section.state 2>/dev/null)
            if [ "$STATE" = "enabled" ]; then
                CONFIG_SECTION="$section"
                break
            elif [ -z "$CONFIG_SECTION" ]; then
                CONFIG_SECTION="$section"
            fi
        fi
    done

    if [ -n "$CONFIG_SECTION" ]; then
        BASE_RAW=$(ubus call qmodem base_info "{\"config_section\":\"$CONFIG_SECTION\"}" 2>/dev/null)
        CELL_RAW=$(ubus call qmodem cell_info "{\"config_section\":\"$CONFIG_SECTION\"}" 2>/dev/null)
        SIM_RAW=$(ubus call qmodem sim_info "{\"config_section\":\"$CONFIG_SECTION\"}" 2>/dev/null)
        NET_RAW=$(ubus call qmodem network_info "{\"config_section\":\"$CONFIG_SECTION\"}" 2>/dev/null)

        if [ -n "$CELL_RAW" ]; then
            NET_MODE=$(get_key "$CELL_RAW" "network_mode")
            MCC=$(get_key "$CELL_RAW" "MCC")
            MNC=$(get_key "$CELL_RAW" "MNC")
            TAC=$(get_key "$CELL_RAW" "TAC")
            CELLID=$(get_key "$CELL_RAW" "Cell ID")
            PCI=$(get_key "$CELL_RAW" "Physical Cell ID")
            ARFCN=$(get_key "$CELL_RAW" "ARFCN")
            BAND=$(get_key "$CELL_RAW" "Band")
            ULBW=$(get_key "$CELL_RAW" "UL Bandwidth")
            DLBW=$(get_key "$CELL_RAW" "DL Bandwidth")
            RSRP=$(get_key "$CELL_RAW" "RSRP")
            RSRQ=$(get_key "$CELL_RAW" "RSRQ")
            SINR=$(get_key "$CELL_RAW" "SINR")
            CA_ARFCN=$(get_key "$CELL_RAW" "ARFCN (CA)")
            CA_PCI=$(get_key "$CELL_RAW" "Physical Cell ID (CA)")
            CA_BAND=$(get_key "$CELL_RAW" "Band (CA)")
        fi

        MODEM_TEMP=$(get_key "$BASE_RAW" "temperature")
        VOLTAGE=$(get_key "$BASE_RAW" "voltage")
        CONNECT_STATUS=$(get_key "$BASE_RAW" "connect_status")

        SIM_STATUS=$(get_key "$SIM_RAW" "SIM Status")
        ISP=$(get_key "$SIM_RAW" "ISP")
        SIM_SLOT=$(get_key "$SIM_RAW" "SIM Slot")
        IMEI=$(get_key "$SIM_RAW" "IMEI")
        ICCID=$(get_key "$SIM_RAW" "ICCID")
        IMSI=$(get_key "$SIM_RAW" "IMSI")
        PHONE=$(get_key "$SIM_RAW" "SIM Number")

        [ -z "$NET_MODE" ] && NET_MODE=$(get_key "$NET_RAW" "Network Type")

        # Normalize official mode strings
        case "$NET_MODE" in
            "NR5G-SA Mode"*) NET_MODE="NR5G-SA" ;;
            "NR5G-NSA Mode"*) NET_MODE="NR5G-NSA" ;;
            "EN-DC Mode"*) NET_MODE="NR5G-NSA" ;;
            "LTE Mode"*) NET_MODE="LTE" ;;
            "WCDMA Mode"*) NET_MODE="WCDMA" ;;
            "NR5G") NET_MODE="NR5G-SA" ;;
        esac

        # Operator: prefer PLMN, fallback to ISP/PLMN code
        OPERATOR="$(plmn_to_operator "${MCC}${MNC}")"
        [ -z "$OPERATOR" ] && OPERATOR="$ISP"
        [ -z "$OPERATOR" ] || [ "$OPERATOR" = "????" ] && OPERATOR="${MCC}${MNC}"
        [ -z "$OPERATOR" ] && OPERATOR="--"

        [ "$CONNECT_STATUS" = "Yes" ] && NET_STATUS="connected" || NET_STATUS="disconnected"
        if [ -d "/sys/class/net/$IFACE" ]; then
            CARRIER=$(cat /sys/class/net/$IFACE/carrier 2>/dev/null || echo 0)
            [ "$CARRIER" = "1" ] && NET_STATUS="connected"
        fi

        IPV4=$(ip -4 addr show $IFACE 2>/dev/null | grep -oE "inet [0-9.]+" | awk '{print $2}')
        IPV6=$(ip -6 addr show $IFACE 2>/dev/null | grep -oE "inet6 [0-9a-f:]+" | head -1 | awk '{print $2}')
        [ -z "$IPV4" ] && IPV4="--"
        [ -z "$IPV6" ] && IPV6="--"

        measure_speed

        # Fallback values
        [ -z "$MCC" ] && MCC="--"
        [ -z "$MNC" ] && MNC="--"
        [ -z "$TAC" ] && TAC="--"
        [ -z "$CELLID" ] && CELLID="--"
        [ -z "$PCI" ] && PCI="--"
        [ -z "$ARFCN" ] && ARFCN="--"
        [ -z "$BAND" ] && BAND="--"
        [ -z "$DLBW" ] && DLBW="--"
        [ -z "$ULBW" ] && ULBW="--"
        [ -z "$RSRP" ] && RSRP="--"
        [ -z "$RSRQ" ] && RSRQ="--"
        [ -z "$SINR" ] && SINR="--"
        [ -z "$MODEM_TEMP" ] && MODEM_TEMP="--"
        [ -z "$VOLTAGE" ] && VOLTAGE="--"
        [ -z "$SIM_STATUS" ] && SIM_STATUS="--"
        [ -z "$IMEI" ] && IMEI="--"
        [ -z "$ICCID" ] && ICCID="--"
        [ -z "$IMSI" ] && IMSI="--"
        [ -z "$PHONE" ] && PHONE="--"
        [ -z "$CA_ARFCN" ] && CA_ARFCN="--"
        [ -z "$CA_PCI" ] && CA_PCI="--"
        [ -z "$CA_BAND" ] && CA_BAND="--"

        ANT_MAIN="$RSRP"; ANT_DIV="$RSRP"; ANT_MIMO1="$RSRP"; ANT_MIMO2="$RSRP"

        cat <<EOF
{
  "networkStatus": "${NET_STATUS}",
  "networkMode": "${NET_MODE}",
  "operator": "${OPERATOR}",
  "band": "${BAND}",
  "bandwidth": "${DLBW}",
  "downloadBandwidth": "${DLBW}",
  "uploadBandwidth": "${ULBW}",
  "rsrp": "${RSRP}",
  "rsrq": "${RSRQ}",
  "sinr": "${SINR}",
  "arfcn": "${ARFCN}",
  "pci": "${PCI}",
  "cellId": "${CELLID}",
  "tac": "${TAC}",
  "qci": "--",
  "imei": "${IMEI}",
  "temperature": "${MODEM_TEMP}",
  "voltage": "${VOLTAGE}",
  "simStatus": "${SIM_STATUS}",
  "iccid": "${ICCID}",
  "imsi": "${IMSI}",
  "phone": "${PHONE}",
  "caArfcn": "${CA_ARFCN}",
  "caPci": "${CA_PCI}",
  "caBand": "${CA_BAND}",
  "downloadSpeed": "${DL_SPEED}",
  "uploadSpeed": "${UL_SPEED}",
  "ipv4": "${IPV4}",
  "ipv6": "${IPV6}",
  "antMain": "${ANT_MAIN}",
  "antDiv": "${ANT_DIV}",
  "antMimo1": "${ANT_MIMO1}",
  "antMimo2": "${ANT_MIMO2}"
}
EOF
        exit 0
    fi
fi

# Fallback: collector cache
if [ -f "$QMI_STATUS" ] && [ -s "$QMI_STATUS" ]; then
    MODTIME=$(stat -c %Y "$QMI_STATUS" 2>/dev/null || echo 0)
    NOW=$(date +%s)
    AGE=$((NOW - MODTIME))
    if [ "$AGE" -lt 10 ]; then
        measure_speed
        sed -e "s/\"downloadSpeed\"[[:space:]]*:[[:space:]]*\"[^\"]*\"/\"downloadSpeed\": \"$DL_SPEED\"/" \
            -e "s/\"downloadSpeed\"[[:space:]]*:[[:space:]]*[0-9.]*/\"downloadSpeed\": \"$DL_SPEED\"/" \
            -e "s/\"uploadSpeed\"[[:space:]]*:[[:space:]]*\"[^\"]*\"/\"uploadSpeed\": \"$UL_SPEED\"/" \
            -e "s/\"uploadSpeed\"[[:space:]]*:[[:space:]]*[0-9.]*/\"uploadSpeed\": \"$UL_SPEED\"/" \
            "$QMI_STATUS"
        exit 0
    fi
fi

cat <<EOF
{"error":"modem data unavailable","networkStatus":"disconnected","operator":"--","networkMode":"--","temperature":"--"}
EOF
