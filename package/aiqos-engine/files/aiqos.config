
# 2026-09-13 用户裁决（**按官方原实现还原**）：
#   一手证据 = 官方固件 board.d/02_network:241-243
#     ucidef_set_interfaces_lan_wan "eth0 hnat" eth1
#   => LAN = eth0(+hnat) ／ WAN = eth1
#   出厂默认两个开关都关 ⇒ `aiqos-lan-foolproof` 完全不干预 network，
#   拓扑原样来自 board.d/02_network（即官方行为）。
config main
	option enabled '1'
	option port_foolproof '0'
	option route_aggregation '0'
	option scenario 'auto'
	option antenna_mode 'directional'
	option antenna_forced '1'
	option offload_mode 'cake_only'
