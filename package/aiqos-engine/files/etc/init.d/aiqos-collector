#!/bin/sh /etc/rc.common
# AiQoS Go Collector - device readiness detection
#
# v64.5 (2026-09-12, O4 / §1.6 #37) 启动优先级梯队（解耦「S99 拥塞」）：
#   aiqosd                  ← 95 档  100ms 数据面控制环（必须最先）
#   aiqos-collector         ← 96 档  本文件：SHM 采集（喂 aiqosd 与面板）
#   aiqos-dataplane-guard   ← 98 档  数据面只读校验/告警
#   其余统计/Web 类（netdata / Airpifanctrl / watchdog 等）保持 99 档
# 目的：杜绝开机瞬间多个服务全顶在 99 争抢调度（设备实测 S99* 达 30 个）。
# 采用 procd 托管；本优先级只影响**开机启动顺序**，不影响运行期。
# ⚠️ 本注释刻意**不写**起始档位赋值的字面量 —— 否则会污染任何按 grep 解析该字段的工具/检查。
#    （判据：`grep -c '^START=' 本文件` 必须 == 1）
START=96
STOP=10
USE_PROCD=1

COLLECTOR=/usr/bin/aiqos-collector
DEV=/dev/cdc-wdm0

wait_for_device() {
    local count=0
    while [ ! -c "$DEV" ]; do
        sleep 2
        count=$((count + 1))
        if [ $count -ge 15 ]; then
            logger -t aiqos-collector "Device $DEV not found after 30s, proceeding anyway"
            return 1
        fi
    done
    logger -t aiqos-collector "Device $DEV ready"
    return 0
}

start_service() {
    logger -t aiqos-collector "Waiting for device..."
    wait_for_device

    procd_open_instance aiqos-collector
    procd_set_param command taskset 0x2 "$COLLECTOR"
    procd_set_param env GOMEMLIMIT=16MiB GOGC=20
    procd_set_param respawn 3600 2 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param limits nofile=4096
    procd_close_instance
}

stop_service() {
    killall aiqos-collector 2>/dev/null
}
