#!/bin/sh /etc/rc.common
# AiQoS aiqosd procd service
# CAKE/ifb0 setup + sysctl tuning + game DSCP marking on start

USE_PROCD=1
START=95
STOP=10

PROG=/usr/bin/aiqosd

setup_cake() {
    # Create ifb0 if not exists
    ip link add name ifb0 type ifb 2>/dev/null || true
    ip link set dev ifb0 up

    # Apply sysctl tuning
    sysctl -p /etc/sysctl.d/99-aiqos-tcp.conf 2>/dev/null || true

    # CAKE on wwan0 (uplink) with overhead 48 for QMI raw IP
    # ── 开机初值（v63.5.1 对齐，2026-09-11）───────────────────────────────
    # 原为 50Mbit(上行)/320Mbit(下行)：引擎接管前（约 10~20s）下行被硬压在 320M，
    # 导致这段时间测速偏低、**易被误判成"设备跑不动"**（假瓶颈）。
    # 现对齐到引擎自身的量程上界，消除该窗口：
    #   下行 = scenario.c 的 urban max_bw_kbit = 1,000,000 kbit → 1000Mbit
    #   上行 = aiqos_calc_ul_bw(): ul = dl/4（受 AMBR 与 5M 下限约束）→ 250Mbit
    # ⚠️ 这两个值与引擎首估算后下发的值同源；改引擎侧上限/比例时须同步改此处
    #   （构建期由 05_调试工具/check-cake-consistency.sh 做一致性校验拦截）。
    tc qdisc replace dev wwan0 root handle 1: cake bandwidth 250Mbit diffserv4 ack-filter memlimit 64M rtt 45ms overhead 48
    tc qdisc replace dev wwan0 ingress handle ffff:
    tc filter replace dev wwan0 parent ffff: protocol all prio 1 u32 match u32 0 0 action mirred egress redirect dev ifb0

    # CAKE on ifb0 (downlink mirror) with overhead 48
    tc qdisc replace dev ifb0 root handle 2: cake bandwidth 1000Mbit diffserv4 memlimit 64M rtt 45ms overhead 48

    # Game device DSCP marking: small packets (<=300B) from/to gaming client -> EF (Voice tin)
    # Identifies latency-sensitive game state traffic by packet size heuristic
    nft add rule ip mangle FORWARD ip saddr 192.168.88.240 ip length 1-300 ip dscp set ef counter 2>/dev/null || true
    nft add rule ip mangle FORWARD ip daddr 192.168.88.240 ip length 1-300 ip dscp set ef counter 2>/dev/null || true
}

start_service() {
    local enabled
    config_load aiqos
    config_get enabled main enabled "1"

    if [ "$enabled" != "1" ]; then
        logger -t aiqosd "aiqosd disabled in UCI"
        return 0
    fi

    logger -t aiqosd "Starting aiqosd engine"
    setup_cake

    # v63.5 hotfix (2026-09-11): 引擎只读 /tmp/aiqos_antenna_mode (tmpfs, 重启即失),
    # 而 uci 的持久值引擎不读 → 引擎重启后天线模式设置"消失"回默认(用户感知"被自动覆盖")。
    # 修复: 启动时从 uci 同步到 /tmp (用户面板设置经 rpcd 已双写 uci+/tmp, 此处保证重启后恢复)。
    _ant_mode=$(uci -q get aiqos.@main[0].antenna_mode 2>/dev/null)
    if [ -n "$_ant_mode" ]; then
        echo "$_ant_mode" > /tmp/aiqos_antenna_mode
        logger -t aiqosd "antenna_mode synced from uci: $_ant_mode"
    fi

    procd_open_instance aiqosd
    procd_set_param command "$PROG"
    procd_set_param limits core="unlimited"
    # respawn retry=0 (34.5j/3.19.1 教训: retry>0 撞墙后 procd 永久放弃,aiqosd 两次重启未拉起)
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

# 34.5j 开机兜底: boot 后 25s 检查进程存活,未起则二次拉起(与 99-zz-aiqos-enable 配对)
boot() {
    start
    ( sleep 25
      if ! pgrep -f "/usr/bin/[a]iqosd" >/dev/null 2>&1; then
          logger -t aiqosd "boot fallback: not running after 25s, re-starting"
          /etc/init.d/aiqosd restart
      fi ) &
}

stop_service() {
    logger -t aiqosd "Stopping aiqosd engine"
    killall aiqosd 2>/dev/null
}